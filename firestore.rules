rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    // الأدمن: حساب Firebase واحد بس (الإيميل ده). مفيش باسورد في الكود أبدًا.
    function isAdmin() { return signedIn() && request.auth.token.email == 'admin.fadl.mummy@pharmily16.app'; }
    function userDoc(uid) { return get(/databases/$(database)/documents/users/$(uid)).data; }

    // ---------- البروفايلات ----------
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isMe(uid)
        && request.resource.data.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.photo is string && request.resource.data.photo.size() < 60000;
      // الاسم ما يتغيرش، والباقي (صورة/لقب/نبذة) تتعدل
      allow update: if isMe(uid)
        && request.resource.data.name == resource.data.name
        && request.resource.data.key == resource.data.key
        && request.resource.data.photo is string && request.resource.data.photo.size() < 60000
        && request.resource.data.nickname.size() <= 30
        && request.resource.data.bio.size() <= 160;
      // الأدمن بس يقدر يلغي تسجيل حد (عشان يسجل من الأول)
      allow delete: if isAdmin();

      // رسايل Future Me (الأدمن مالوش وصول ليها) (خاصة بصاحبها بس)
      match /future/{id} {
        allow read, delete: if isMe(uid);
        allow create: if isMe(uid) && request.resource.data.text is string && request.resource.data.text.size() <= 2000;
      }
    }

    // ---------- الميموريز ----------
    match /memories/{id} {
      allow read: if signedIn();
      // الاسم إجباري ولازم يطابق اسم صاحب الحساب (مفيش حد ينشر باسم حد تاني)
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName == userDoc(request.auth.uid).name
        && request.resource.data.caption is string
        && request.resource.data.caption.size() > 0 && request.resource.data.caption.size() <= 300
        && request.resource.data.thumb is string && request.resource.data.thumb.size() < 200000;

      // التعديل: (1) صاحب الذكرى يعدّل الكابشن بس  (2) أي حد يغيّر رياكته هو بس  (3) عداد التعليقات يتغير بواحد
      allow update: if signedIn() && (
        ( isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['caption', 'edited'])
          && request.resource.data.caption is string
          && request.resource.data.caption.size() > 0 && request.resource.data.caption.size() <= 300 )
        ||
        ( resource.data.authorId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['caption', 'edited'])
          && request.resource.data.caption is string
          && request.resource.data.caption.size() > 0 && request.resource.data.caption.size() <= 300 )
        ||
        ( request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rx'])
          && request.resource.data.rx.diff(resource.data.get('rx', {})).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.rx[request.auth.uid] in ['', 'like', 'love', 'care', 'haha', 'wow', 'sad', 'angry'] )
        ||
        ( request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cc'])
          && request.resource.data.cc is int
          && request.resource.data.cc >= 0
          && math.abs(request.resource.data.cc - resource.data.get('cc', 0)) <= 1 )
      );
      allow delete: if signedIn() && (resource.data.authorId == request.auth.uid || isAdmin());

      // الصورة الكبيرة (بتتحمل لما حد يفتح الصورة بس)
      match /blobs/{b} {
        allow read: if signedIn();
        allow create: if signedIn()
          && get(/databases/$(database)/documents/memories/$(id)).data.authorId == request.auth.uid
          && request.resource.data.data is string && request.resource.data.data.size() < 950000;
        allow delete: if signedIn() && (isAdmin()
          || get(/databases/$(database)/documents/memories/$(id)).data.authorId == request.auth.uid);
      }

      // التعليقات
      match /comments/{cid} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName == userDoc(request.auth.uid).name
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500;
        // صاحب التعليق أو صاحب الذكرى يمسحوه
        allow delete: if signedIn() && (isAdmin() || resource.data.authorId == request.auth.uid
          || get(/databases/$(database)/documents/memories/$(id)).data.authorId == request.auth.uid);
        allow update: if false;
      }
    }

    // ---------- Our Journey (الأدمن بس هو اللي يضيف ويمسح) ----------
    match /journey/{id} {
      allow read: if signedIn();
      allow create: if isAdmin()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.year is int
        && request.resource.data.year >= 0 && request.resource.data.year < 6
        && request.resource.data.text is string && request.resource.data.text.size() <= 600
        && request.resource.data.thumb is string && request.resource.data.thumb.size() < 200000
        && (request.resource.data.text.size() > 0 || request.resource.data.thumb.size() > 0);
      // الأدمن بس يقدر يغير الكابشن (النص) بتاع صور الجيرني
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text'])
        && request.resource.data.text is string && request.resource.data.text.size() <= 600;
      allow delete: if isAdmin();

      match /blobs/{b} {
        allow read: if signedIn();
        allow create: if isAdmin()
          && request.resource.data.data is string && request.resource.data.data.size() < 950000;
        allow delete: if isAdmin();
      }
    }

    // ---------- كابشنات صور الجيرني الثابتة (اللي جاية من ملفات الموقع): الأدمن بس يعدّل أو يخفي ----------
    match /journeyCaps/{id} {
      allow read: if signedIn();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['caption', 'hidden'])
        && (!('caption' in request.resource.data) || (request.resource.data.caption is string && request.resource.data.caption.size() <= 600))
        && (!('hidden' in request.resource.data) || request.resource.data.hidden is bool);
    }

    // ---------- إلغاء التسجيل (رقم نسخة لكل طالب، بيقراه أي حد وبيكتبه الأدمن بس) ----------
    match /resets/{k} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.data.ver is int;
    }

    // ---------- الشات (بين اتنين بس — الأدمن مش عضو فمش بيشوف أي رسالة) ----------
    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && chatId.matches('.*' + request.auth.uid + '.*');
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members;
      allow delete: if false;

      match /messages/{mid} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members
          && request.resource.data.from == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000;
        allow update, delete: if false;
      }
    }
  }
}
